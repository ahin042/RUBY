puts "-----간단한 연산-----"
puts 1+2 #덧셈
puts 5-3 #뺄셈
puts 2*3 #곱셈
puts 1/3 #나눗셈
puts 1.0/3.0 #나눗셈
puts 1%3 #나머지
puts 2**3 #제곱
puts Math::PI #원주율
puts "-----올림 반올림 내림-----"
puts 2.3.ceil #올림
puts 2.3.floor #내림
puts 2.3.round #반올림
puts 2.5.round
puts "-----원의 넓이 계산-----"
print '반지름 3인 원의 넓이 : '
puts 3 ** 2 * Math::PI